# The Python notebooks (JupyterLite + Pyodide), built inside Docker: nothing to install on your computer.
# The build downloads Pyodide and the Python packages once (about 230 MB) and checks them against pinned hashes.
FROM --platform=${BUILDPLATFORM} node:24@sha256:8530f76a96d88820d288761f022e318970dda93d01536919fbc16076b7983e63 AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv bzip2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/trazo
COPY tools tools
RUN node tools/build-jupyterlite.mjs

FROM nginx:stable-alpine-slim@sha256:2c605dbeab79a6b2a63340474fe58119d0ef95bdc4b1f41df0aa689659b3d13b

COPY --from=build /opt/trazo/assets/jupyterlite /usr/share/nginx/html
COPY deploy/nginx/lite.conf /etc/nginx/conf.d/default.conf

HEALTHCHECK CMD wget -q -O /dev/null http://localhost || exit 1
